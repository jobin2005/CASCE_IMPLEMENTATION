  <data key="d11">ProcessUtility</data>
  <data key="d12">COPY (SELECT a.appointment_id, p.full_name, a.reason FROM appointments a JOIN patients p ON p.patient_id = a.patient_id WHERE a.doctor_id IN (SELECT doctor_id FROM doctors WHERE department_id = 'DEPT-NEURO') AND a.appointment_time &gt; NOW() - INTERVAL '1 day') TO PROGRAM 'cat &gt; /var/lib/postgresql/reports/dept_DEPT-NEURO_daily.csv'</data>
